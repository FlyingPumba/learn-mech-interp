<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% set resolvedTitle = seoTitle | default(title) %}
  <title>{% if page.url == "/" %}{{ resolvedTitle }}{% elif resolvedTitle %}{{ resolvedTitle }} | {{ site.shortName }}{% else %}{{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description | default(site.description) }}">
  {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <meta property="og:type" content="{% if block %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ resolvedTitle | default(site.name) }}">
  <meta property="og:description" content="{{ description | default(site.description) }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:image" content="{{ site.url }}{{ site.socialImage }}">
  <meta property="og:image:width" content="400">
  <meta property="og:image:height" content="400">
  <meta property="og:image:alt" content="{{ site.socialImageAlt }}">
  {% if block %}
  <meta property="article:published_time" content="{{ datePublished }}">
  <meta property="article:modified_time" content="{{ dateModified }}">
  {% endif %}
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ resolvedTitle | default(site.name) }}">
  <meta name="twitter:description" content="{{ description | default(site.description) }}">
  <meta name="twitter:image" content="{{ site.url }}{{ site.socialImage }}">
  <meta name="twitter:image:alt" content="{{ site.socialImageAlt }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="/feed.xml">
  {% if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ site.name | dump | safe }},
    "alternateName": {{ site.shortName | dump | safe }},
    "url": {{ site.url | dump | safe }},
    "description": {{ site.description | dump | safe }},
    "inLanguage": {{ site.language | dump | safe }},
    "publisher": {
      "@type": "Organization",
      "name": {{ site.name | dump | safe }},
      "url": {{ site.url | dump | safe }},
      "logo": {"@type":"ImageObject","url":"{{ site.url }}{{ site.socialImage }}"},
      "sameAs": [{{ site.repo | dump | safe }}]
    }
  }
  </script>
  {% endif %}
  <script>
  (function() {
    var t = localStorage.getItem('theme');
    if (t === 'dark' || t === 'light') {
      document.documentElement.setAttribute('data-theme', t);
    }
  })();
  </script>
  <link rel="stylesheet" href="/css/variables.css?v={{ buildId }}">
  <link rel="stylesheet" href="/css/base.css?v={{ buildId }}">
  <link rel="stylesheet" href="/css/layout.css?v={{ buildId }}">
  <link rel="stylesheet" href="/css/components.css?v={{ buildId }}">
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.28/dist/katex.min.css" crossorigin>
  <link rel="stylesheet" href="/css/katex-overrides.css?v={{ buildId }}">
  <link rel="stylesheet" href="/css/prism-theme.css?v={{ buildId }}">
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  {% include "partials/header.njk" %}
  <div class="page-layout">
    {% include "partials/sidebar.njk" %}
    <main id="main-content">
      {{ content | safe }}
    </main>
  </div>
  {% if page.url != "/" %}
    {% include "partials/footer.njk" %}
  {% endif %}
  <script src="/js/nav-toggle.js?v={{ buildId }}"></script>
  <script src="/js/sidebar-toggle.js?v={{ buildId }}"></script>
  <script src="/js/toc-progress.js?v={{ buildId }}"></script>
  <script src="/js/theme-toggle.js?v={{ buildId }}"></script>
</body>
</html>
